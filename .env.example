# Copy to .env and fill in. Never commit real secrets.

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Publishable key is sent to the browser for Stripe.js card capture.
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# --- WhatsApp Business API (Meta Cloud API) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=changeme
WHATSAPP_APP_SECRET=

# --- App ---
NEXT_PUBLIC_APP_NAME=RestoMaster
# Secret used to sign auth tokens. Set a strong value in production.
AUTH_SECRET=dev-insecure-secret-change-me
# Where the JSON data store lives (relative to the web app cwd).
RESTO_DATA_FILE=.data/store.json
# Which location inbound WhatsApp messages route to (defaults to first).
RESTO_WHATSAPP_LOCATION_ID=
