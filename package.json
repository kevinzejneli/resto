{
  "name": "restomaster",
  "private": true,
  "description": "Restaurant OS for Balkan/MENA small chains: POS + inventory + WhatsApp ordering",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @resto/web dev",
    "dev:mobile": "pnpm --filter @resto/mobile start",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
